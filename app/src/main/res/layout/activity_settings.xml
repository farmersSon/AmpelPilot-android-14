<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context="de.hsaugsburg.ampelpilot.SettingsActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        android:paddingBottom="24dp" />

    <!-- Stability window (formerly "Frames") -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/stability"
            android:textColor="@android:color/white"
            android:textSize="22sp" />

        <Button
            android:id="@+id/helpButtonFrames"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/roundedbutton"
            android:text="@string/help"
            android:contentDescription="Hilfe zur Erkennungsdauer"
            android:textSize="22sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_Frames"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/Text_SeekBar"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:paddingTop="4dp" />

    <SeekBar
        android:id="@+id/seekBar_Frames"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="7"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Schneller"
            android:textColor="@android:color/darker_gray" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Zuverl\u00e4ssiger"
            android:textColor="@android:color/darker_gray" />
    </LinearLayout>

    <!-- Tilt pause toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="32dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tilt_pause"
            android:textColor="@android:color/white"
            android:textSize="22sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_TiltPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tilt_pause_desc"
        android:textColor="@android:color/darker_gray"
        android:textSize="14sp"
        android:paddingTop="4dp" />

    <!-- Torch toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/torch"
            android:textColor="@android:color/white"
            android:textSize="22sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_Torch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/torch_desc"
        android:textColor="@android:color/darker_gray"
        android:textSize="14sp"
        android:paddingTop="4dp" />

    <!-- Debug logging toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/logging"
            android:textColor="@android:color/white"
            android:textSize="22sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_Logging"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/logging_desc"
        android:textColor="@android:color/darker_gray"
        android:textSize="14sp"
        android:paddingTop="4dp" />

    <Button
        android:id="@+id/btnShareLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/share_log" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnGo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@android:color/holo_orange_dark"
            android:text="Fertig" />

        <Button
            android:id="@+id/btnHelp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@android:color/holo_orange_dark"
            android:text="Hilfe" />
    </LinearLayout>

</LinearLayout>
